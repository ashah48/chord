+
+var chordEmojiShortcode = regexp.MustCompile(`:[A-Za-z0-9_~]+:`)
+
+func (portal *Portal) formatDiscordShortcodes(text string, session *discordgo.Session) string {
+	matches := chordEmojiShortcode.FindAllStringIndex(text, -1)
+	if session == nil || portal.GuildID == "" || len(matches) == 0 {
+		return escapeDiscordMarkdown(text)
+	}
+	guild, err := session.State.Guild(portal.GuildID)
+	if err != nil {
+		return escapeDiscordMarkdown(text)
+	}
+	session.State.RLock()
+	emojis := make(map[string]string, len(guild.Emojis))
+	for _, emoji := range guild.Emojis {
+		if emoji != nil && emoji.ID != "" && emoji.Name != "" {
+			emojis[strings.ToLower(emoji.Name)] = emoji.MessageFormat()
+		}
+	}
+	session.State.RUnlock()
+
+	var output strings.Builder
+	offset := 0
+	for _, match := range matches {
+		start, end := match[0], match[1]
+		if start > 0 && !strings.ContainsRune(" \t\n([{", rune(text[start-1])) {
+			continue
+		}
+		if emoji, ok := emojis[strings.ToLower(text[start+1:end-1])]; ok {
+			output.WriteString(escapeDiscordMarkdown(text[offset:start]))
+			output.WriteString(emoji)
+			offset = end
+		}
+	}
+	output.WriteString(escapeDiscordMarkdown(text[offset:]))
+	return output.String()
+}
