+func (p *ProvisioningAPI) roomNicknames(w http.ResponseWriter, r *http.Request) {
+	user := r.Context().Value("user").(*User)
+	user.Lock()
+	session := user.Session
+	user.Unlock()
+	nicknames := map[string]string{}
+	portal := p.bridge.GetPortalByMXID(id.RoomID(r.URL.Query().Get("room_id")))
+	if session != nil && portal != nil && portal.GuildID != "" {
+		state := session.State
+		if guild, err := state.Guild(portal.GuildID); err == nil {
+			state.RLock()
+			for _, member := range guild.Members {
+				if member != nil && member.User != nil && member.Nick != "" {
+					nicknames[p.bridge.FormatPuppetMXID(member.User.ID).String()] = member.Nick
+				}
+			}
+			state.RUnlock()
+		}
+	}
+	jsonResponse(w, http.StatusOK, nicknames)
+}
