+type roomEmojiEntry struct {
+	ID   string `json:"id"`
+	Name string `json:"name"`
+	MXC  string `json:"mxc,omitempty"`
+}
+
+func (p *ProvisioningAPI) roomEmoji(w http.ResponseWriter, r *http.Request) {
+	user := r.Context().Value("user").(*User)
+	session := user.Session
+	if session == nil {
+		jsonResponse(w, http.StatusServiceUnavailable, Error{Error: "Discord is disconnected", ErrCode: ErrCodeNotConnected})
+		return
+	}
+	query := r.URL.Query()
+	portal := p.bridge.GetPortalByMXID(id.RoomID(query.Get("room_id")))
+	if portal == nil || portal.GuildID == "" {
+		jsonResponse(w, http.StatusNotFound, Error{Error: "Discord server room not found", ErrCode: mautrix.MNotFound.ErrCode})
+		return
+	}
+	state := session.State
+	guild, err := state.Guild(portal.GuildID)
+	if err != nil {
+		jsonResponse(w, http.StatusNotFound, Error{Error: "Discord server is unavailable", ErrCode: mautrix.MNotFound.ErrCode})
+		return
+	}
+
+	state.RLock()
+	emojis := append([]*discordgo.Emoji(nil), guild.Emojis...)
+	state.RUnlock()
+	wanted := query.Get("emoji_id")
+	items := make([]roomEmojiEntry, 0, len(emojis))
+	for _, emoji := range emojis {
+		if emoji.ID == "" || emoji.Name == "" || (wanted != "" && emoji.ID != wanted) {
+			continue
+		}
+		if wanted != "" {
+			mxc := portal.getEmojiMXCByDiscordID(emoji.ID, emoji.Name, emoji.Animated)
+			if mxc.IsEmpty() {
+				jsonResponse(w, http.StatusBadGateway, Error{Error: "Could not load the Discord emoji", ErrCode: "M_UNKNOWN"})
+				return
+			}
+			jsonResponse(w, http.StatusOK, roomEmojiEntry{ID: emoji.ID, Name: emoji.Name, MXC: mxc.String()})
+			return
+		}
+		entry := roomEmojiEntry{ID: emoji.ID, Name: emoji.Name}
+		if mxc := p.bridge.DMA.EmojiMXC(emoji.ID, emoji.Name, emoji.Animated); !mxc.IsEmpty() {
+			entry.MXC = mxc.String()
+		} else {
+			emojiURL := discordgo.EndpointEmoji(emoji.ID)
+			if emoji.Animated {
+				emojiURL = discordgo.EndpointEmojiAnimated(emoji.ID)
+			}
+			if file := p.bridge.DB.File.Get(emojiURL, false); file != nil {
+				entry.MXC = file.MXC.String()
+			}
+		}
+		items = append(items, entry)
+	}
+	if wanted != "" {
+		jsonResponse(w, http.StatusNotFound, Error{Error: "Discord emoji not found", ErrCode: mautrix.MNotFound.ErrCode})
+		return
+	}
+	jsonResponse(w, http.StatusOK, map[string]interface{}{"items": items})
+}
