+func (p *ProvisioningAPI) roomReactions(w http.ResponseWriter, r *http.Request) {
+	user := r.Context().Value("user").(*User)
+	user.Lock()
+	session := user.Session
+	user.Unlock()
+	if session == nil {
+		jsonResponse(w, http.StatusServiceUnavailable, Error{Error: "Discord is disconnected", ErrCode: ErrCodeNotConnected})
+		return
+	}
+	portal := p.bridge.GetPortalByMXID(id.RoomID(r.URL.Query().Get("room_id")))
+	if portal == nil {
+		jsonResponse(w, http.StatusNotFound, Error{Error: "Discord room not found", ErrCode: mautrix.MNotFound.ErrCode})
+		return
+	}
+	var input struct {
+		Messages []id.EventID `json:"messages"`
+	}
+	if err := json.NewDecoder(http.MaxBytesReader(w, r.Body, 65536)).Decode(&input); err != nil || len(input.Messages) > 100 {
+		jsonResponse(w, http.StatusBadRequest, Error{Error: "Invalid message list", ErrCode: mautrix.MBadJSON.ErrCode})
+		return
+	}
+
+	type channelPage struct {
+		newest uint64
+		mapping map[string][]id.EventID
+	}
+	channels := map[string]*channelPage{}
+	for _, eventID := range input.Messages {
+		msg := p.bridge.DB.Message.GetByMXID(portal.Key, eventID)
+		if msg == nil {
+			continue
+		}
+		snowflake, err := strconv.ParseUint(msg.DiscordID, 10, 64)
+		if err != nil || snowflake == ^uint64(0) {
+			continue
+		}
+		channelID := msg.DiscordProtoChannelID()
+		page := channels[channelID]
+		if page == nil {
+			page = &channelPage{mapping: map[string][]id.EventID{}}
+			channels[channelID] = page
+		}
+		page.newest = max(page.newest, snowflake)
+		page.mapping[msg.DiscordID] = append(page.mapping[msg.DiscordID], eventID)
+	}
+	output := map[id.EventID][]chordReactionCount{}
+	customKeys := map[string]string{}
+	for channelID, page := range channels {
+		messages, err := session.ChannelMessages(channelID, 100, strconv.FormatUint(page.newest+1, 10), "", "", portal.RefererOptIfUser(session, channelID)...)
+		if err != nil {
+			jsonResponse(w, http.StatusBadGateway, Error{Error: "Could not read Discord reactions", ErrCode: "M_UNKNOWN"})
+			return
+		}
+		for _, msg := range messages {
+			eventIDs := page.mapping[msg.ID]
+			if len(eventIDs) == 0 {
+				continue
+			}
+			counts := make([]chordReactionCount, 0, len(msg.Reactions))
+			for _, reaction := range msg.Reactions {
+				if reaction == nil || reaction.Emoji == nil || reaction.Count <= 0 {
+					continue
+				}
+				emoji := reaction.Emoji
+				item := chordReactionCount{Count: reaction.Count, Mine: reaction.Me}
+				if emoji.ID == "" {
+					item.Key = variationselector.Add(emoji.Name)
+				} else {
+					item.Shortcode = ":" + emoji.Name + ":"
+					if _, ok := customKeys[emoji.ID]; !ok {
+						mxc := portal.getEmojiMXCByDiscordID(emoji.ID, emoji.Name, emoji.Animated)
+						if !mxc.IsEmpty() {
+							customKeys[emoji.ID] = mxc.String()
+						}
+					}
+					item.Key = customKeys[emoji.ID]
+				}
+				if item.Key != "" {
+					counts = append(counts, item)
+				}
+			}
+			if len(counts) == len(msg.Reactions) {
+				for _, eventID := range eventIDs {
+					output[eventID] = counts
+				}
+			}
+		}
+	}
+	jsonResponse(w, http.StatusOK, output)
+}
